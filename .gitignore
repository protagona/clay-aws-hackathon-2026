/runs/
.venv/
__pycache__/
*.pyc
cdk.out/
node_modules/
.pytest_cache/
dist/
batches/

# rubric import (increment 8): drafts and original source documents stay local; history is tracked
tasks/*/rubrics/drafts/
tasks/*/rubrics/sources/
tasks/*/rubrics/.rubric.lock
# prompts store (increment 13): its lock and any temp file a crash leaves behind
tasks/*/.prompts.lock
tasks/*/*.tmp-*

# staged imagery samples (requirement-gaps): uploaded to each deployment bucket, never committed
/samples/
